rules_version = '2';
// The API uses the Firestore Admin SDK. Browsers are not granted access.
// Admin SDK bypasses these rules, so every patient read and write is
// authorised in application code. Do not open private user documents here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
