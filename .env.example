# Copy this file to .env and fill in the values. .env is gitignored —
# never commit real keys. server.py reads .env at startup.

# ── Login (Clerk) ──────────────────────────────────
# true = sign-in required; false = no login, everything runs as 'local-dev'
AUTH_ENABLED=true
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk user ids (user_...) that see every patient, comma-separated, no spaces.
# Sign in once and copy your id from the "[Auth] Signed in: user_..." console
# line (or Clerk dashboard -> Users -> User ID). Admins have no chart limit and
# get the admin page: the "Admin" button on the home page, or /admin
# (accounts, charts, delete chart / reset allowance / delete all data).
ADMIN_CLERK_USER_IDS=
# Who sees the "RL Report" below the LLM report on the results page:
# all (default, while testing) | admins (ids above) | none
RL_REPORT_VISIBLE_TO=all
# Early-access testers: the "Tester" button at the bottom of the home page asks for this
# password. Testers get no 2-chart limit, only TESTER_DAILY_CAP new charts per day, see
# every algorithm + the chatbot, and rate the accuracy. Empty = Tester button can't unlock.
TESTER_PASSWORD=
TESTER_DAILY_CAP=30
# Password for the "Dev" side of the View Mode toggle on the results page.
# Empty = Dev view can't be opened. Spaces around it are ignored.
DEV_MODE_PASSWORD=
# Open the app at this address; Clerk tokens from any other address are rejected.
FRONTEND_URL=http://localhost:5000

# ── API keys and app secrets (ask the team) ────────
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
SERPER_API_KEY=

# ── Gemini (Vertex AI, no API key) ─────────────────
# Uses the Google login: `gcloud auth application-default login` on a PC,
# the VM's service account on the server (needs the "Vertex AI User" role).
# Region, default asia-south1 (Mumbai). Project defaults to FIRESTORE_PROJECT_ID.
GEMINI_LOCATION=asia-south1
# GEMINI_PROJECT=
# Long random strings. Keep them the same forever once set:
# changing SECRET_KEY signs everyone out, changing DEIDENTIFICATION_SECRET changes patient tokens.
SECRET_KEY=
DEIDENTIFICATION_SECRET=

# ── Docker / VM only (gunicorn) ────────────────────
# Chat sessions live in the server's memory: keep ONE worker, with threads.
# WEB_CONCURRENCY=1
# GUNICORN_CMD_ARGS=--threads 8

# ── Main DB (Firestore) ────────────────────────────
# Leave both empty for the in-memory test DB (cleared on every restart).
# FIRESTORE_BACKEND=firestore
# FIRESTORE_PROJECT_ID=

# ── Agentic layers (agentic/, agentic_disease_first/, agentic_disease_compare/, agentic_combined/) ──
# No GEMINI_API_KEY = rule-based critic + code-built summary (no model is called).
# A key makes the agents call Gemini; org policy may block API keys, so leave it empty on the VM.
# GEMINI_API_KEY=
# LLM_TIMEOUT=20
# LLM_MAX_RETRIES=1
# true = also try the planet_heavy / rashi_heavy weight profiles (default false: today's weights only)
# AGENTIC_MULTI_PROFILE=false
# false = run Disease First / Disease Compare as the plain engines
# AGENTIC_DISEASE_LOGIC=true
# false = run the Combined Algo as the plain function (no agent)
# AGENTIC_COMBINED=true
